NODE_ENV=development
PORT=3000
LISTEN_HOST=127.0.0.1
DATABASE_URL=postgresql://voice_agent:voice_agent@127.0.0.1:5433/voice_agent

# Optional: shared secret for POST /adapters/voice/inbound. Leave empty to run unauthenticated locally.
VOICE_INBOUND_SECRET=

# Optional: secret for POST /demo/orchestrate.
DEMO_ORCHESTRATE_SECRET=

# Read-only token for public demo session/evaluation GETs (never a real provider API key).
DEMO_PUBLIC_TOKEN=

# Optional: voice provider credentials (Vapi or any OpenAI-compatible TTS/STT provider).
VOICE_PROVIDER_API_KEY=
VOICE_PROVIDER_BASE_URL=

VOICE_TIMEOUT_MS=2000
VOICE_DEFAULT_LOCALE=es
VOICE_INBOUND_MAX_SKEW_MS=60000
VOICE_INBOUND_RATE_LIMIT=30
VOICE_INBOUND_RATE_WINDOW_MS=60000

# runtime-demo = built-in demo agent (default, no credentials needed)
# telco-service-agent = simulated telecom customer-service demo
VOICE_SESSION_OWNER=runtime-demo

# runtime = inbound transcript runs handleAgentTurn (Option A, default).
# vapi   = Vapi LLM owns reasoning; tools POST to /adapters/voice/tools (Option B).
VOICE_REASONING_OWNER=runtime

# Optional: OpenAI-compatible LLM endpoint. Leave empty to use the in-process fake LLM (no API calls).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_ID=fake
LLM_TIMEOUT_MS=1500

# Optional: Supabase for hosted durable persistence. Backend only. Never put these in web/.env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
